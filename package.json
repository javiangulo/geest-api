{
  "name": "geest-api",
  "version": "1.0.0",
  "main": "src/index.ts",
  "scripts": {
    "start": "rm -rf dist && pnpm run build && node dist/index.js",
    "start:debug": "node --inspect dist/index.js",
    "dev": "tsx watch --env-file=.env src/index.ts",
    "dev:debug": "tsx watch --inspect --env-file=.env src/index.ts",
    "build": "rm -rf dist && tsc --project tsconfig.json && tsc-alias -p tsconfig.json",
    "lint": "biome lint ./src",
    "format": "biome format --write ./src",
    "format:check": "biome format ./src",
    "check": "biome check --write ./src",
    "test": "tsx --test test/**/*.test.ts",
    "test:debug": "tsx --test --inspect test/**/*.test.ts"
  },
  "keywords": [],
  "author": "",
  "license": "ISC",
  "description": "",
  "dependencies": {
    "cors": "^2.8.6",
    "express": "^5.2.1",
    "express-rate-limit": "^8.6.2",
    "helmet": "^8.3.0",
    "pg": "^8.23.0",
    "reflect-metadata": "^0.2.2",
    "typeorm": "^1.1.0"
  },
  "devDependencies": {
    "@biomejs/biome": "^2.5.10",
    "@types/cors": "^2.8.19",
    "@types/express": "^5.0.6",
    "@types/node": "26.2.0",
    "@types/pg": "^8.23.1",
    "tsc-alias": "^1.9.2",
    "tsx": "^4.23.12",
    "typescript": "^7.0.2"
  }
}
