{
  "compilerOptions": {
    "target": "es2022",
    "module": "commonjs",
    "outDir": "./dist",
    "rootDir": ".",
    "allowSyntheticDefaultImports": true,
    "removeComments": true,
    "esModuleInterop": true,
    "forceConsistentCasingInFileNames": true,
    "strict": true,
    "skipLibCheck": true,
    "resolveJsonModule": true,
    "experimentalDecorators": true,
    "emitDecoratorMetadata": true,
    "paths": {
      "@app/*": ["./src/*"],
      "@common/*": ["./src/common/*"],
      "@hexagonal/*": ["./src/hexagonal/*"],
      "@domain/*": ["./src/hexagonal/domain/*"],
      "@application/*": ["./src/hexagonal/application/*"],
      "@infrastructure/*": ["./src/hexagonal/infrastructure/*"],
      "@presentation/*": ["./src/hexagonal/presentation/*"]
    }
  },
  "include": ["./src", "./test"],
  "exclude": ["node_modules"]
}
