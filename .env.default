# Server
PORT=5500
HOSTNAME=localhost
NODE_ENV=development

# Database Provider ('postgres' | 'none')
DB_PROVIDER=postgres

# Option 1: Full Connection URL (takes precedence if provided)
POSTGRES_URL=postgresql://postgres:postgres@localhost:5432/geest_db

# Option 2: Individual Connection Parameters (used if POSTGRES_URL is empty)
POSTGRES_HOST=localhost
POSTGRES_PORT=5432
POSTGRES_USER=postgres
POSTGRES_PASSWORD=postgres
POSTGRES_DB=geest_db

# TypeORM Settings
POSTGRES_SYNCHRONIZE=true
POSTGRES_LOGGING=false

# External Notifications
NOTIFY_URL=https://webhook.site/test-notifications
